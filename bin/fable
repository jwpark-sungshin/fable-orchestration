#!/usr/bin/env bash
# Fable orchestration toggle.

set -u

FABLE_DIR="$HOME/.claude/fable"
AGENT_DIR="$HOME/.claude/agents"
STATE_FILE="$HOME/.claude/.fable-state"

AGENTS=(executor explainer researcher runner)
LEGACY_AGENTS=(deep-reasoner research-executor)

# Managed links are relative (../fable/agents/X.md); older installs used
# absolute links, which are still recognised.
_is_managed_agent() {
  local link="$AGENT_DIR/$1.md" target

  [ -L "$link" ] || return 1
  target="$(readlink "$link")"
  [ "$target" = "../fable/agents/$1.md" ] \
    || [ "$target" = "$FABLE_DIR/agents/$1.md" ]
}

_remove_managed_agents() {
  local name

  for name in "$@"; do
    if _is_managed_agent "$name"; then
      unlink "$AGENT_DIR/$name.md"
    fi
  done
}

_enable_agents() {
  mkdir -p "$AGENT_DIR"
  _remove_managed_agents "${LEGACY_AGENTS[@]}"

  local name
  for name in "${AGENTS[@]}"; do
    ln -sfn \
      "../fable/agents/$name.md" \
      "$AGENT_DIR/$name.md"
  done
}

_disable_agents() {
  _remove_managed_agents "${AGENTS[@]}" "${LEGACY_AGENTS[@]}"
}

case "${1:-status}" in
  on)
    echo on > "$STATE_FILE"
    _enable_agents
    echo "Fable orchestration is ON. Start a new Claude session to apply it."
    ;;

  off)
    echo off > "$STATE_FILE"
    _disable_agents
    echo "Fable orchestration is OFF. New Claude sessions will use normal mode."
    ;;

  status)
    state=$(cat "$STATE_FILE" 2>/dev/null || echo off)
    echo "Fable orchestration: ${state^^}"

    grep -q 'fable/env.sh' "$HOME/.bashrc" 2>/dev/null \
      && ok='[OK]' || ok='[--]'
    echo "  $ok shell wrapper"

    grep -q 'append-system-prompt-file' "$FABLE_DIR/env.sh" 2>/dev/null \
      && ok='[OK]' || ok='[--]'
    echo "  $ok main-only prompt injection"

    if [ "$state" = "on" ]; then
      for name in "${AGENTS[@]}"; do
        if _is_managed_agent "$name"; then
          ok='[OK]'
        else
          ok='[--]'
        fi

        echo "  $ok agent: $name"
      done
    else
      echo "  [--] agents disabled"
    fi

    grep -q 'orchestration-gate' "$HOME/.claude/settings.json" 2>/dev/null \
      && ok='[OK]' || ok='[--]'
    echo "  $ok orchestration gate"

    [ -x "$FABLE_DIR/hooks/orchestration-gate.py" ] \
      && ok='[OK]' || ok='[--]'
    echo "  $ok gate executable"
    ;;

  *)
    echo "Usage: fable on | off | status" >&2
    exit 1
    ;;
esac
